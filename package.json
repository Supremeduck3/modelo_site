{
  "name": "moldesite",
  "version": "1.0.0",
  "description": "Projeto template padrão didático de front-end com Next.js 16 (App Router) e React 19.",
  "private": true,
  "type": "module",
  "keywords": [
    "javascript",
    "nextjs",
    "next",
    "react",
    "app-router",
    "front-end",
    "frontend",
    "biome",
    "codeverse"
  ],
  "homepage": "https://codeverse.dev.br/",
  "author": {
    "name": "Marcello",
    "url": "https://github.com/mapcarboni/"
  },
  "contributors": [
    {
      "name": "Thiago",
      "url": "https://github.com/thiago-rferreira/"
    }
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "node --test \"tests/**/*.test.js\"",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:setup": "prisma migrate deploy && node prisma/seed.js",
    "db:seed": "node prisma/seed.js",
    "db:seed:demo": "node prisma/seed-demo.js",
    "db:seed:demo:limpar": "node prisma/seed-demo-limpar.js",
    "implantacao:check": "node scripts/verificar-implantacao.js",
    "db:studio": "prisma studio",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@prisma/client": "^6.19.3",
    "antd": "^6.6.4",
    "axios": "^1.20.0",
    "next": "^16.3.5",
    "nodemailer": "^10.0.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "^1.63.0",
    "babel-plugin-react-compiler": "1.0.0",
    "prisma": "^6.19.3"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
