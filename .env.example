# Configuração por implantação. Copie para .env.local e preencha.
# NUNCA versione segredos.

# URL pública do site (usada em SEO/Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Banco de dados desta implantação (PostgreSQL).
#
# DATABASE_URL  — usada pelas consultas do site
# DIRECT_URL    — usada pelas migrations
#
# PADRÃO: Supabase. Um projeto por cliente, nunca um projeto compartilhado.
# As duas strings saem de Project Settings -> Database. Elas são diferentes de
# propósito: a 6543 é o pooler (não aceita DDL), a 5432 é a conexão direta.
DATABASE_URL="postgresql://postgres.<ref>:<senha>@<host>:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<senha>@<host>:5432/postgres"

# PostgreSQL próprio (entrega avulsa, ou desenvolvimento local): as duas são
# iguais, porque não há pooler no meio.
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/site_modelo"
# DIRECT_URL="postgresql://usuario:senha@localhost:5432/site_modelo"

# Nome usado pelo seed ao criar a empresa (opcional; padrão vem do seed)
SEED_COMPANY_NAME=""

# Segredo que assina a sessão do painel. Obrigatório para o painel funcionar.
# Gere com: openssl rand -base64 48
# Trocar este valor invalida todas as sessões abertas.
AUTH_SECRET=""

# Primeiro usuário do painel, criado pelo seed. Sem os dois, nenhum usuário é
# criado (não existe usuário padrão). O seed nunca sobrescreve um já existente,
# então a senha trocada pela empresa fica preservada.
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# E-mail transacional. Sem SMTP_HOST e MAIL_FROM o site funciona igual, só não
# envia (em desenvolvimento a mensagem vai para o log). Porta 465 usa TLS direto;
# as outras sobem para TLS via STARTTLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""

# Declare 1 apenas se houver proxy/CDN confiável reescrevendo X-Forwarded-For
# na frente da aplicação. Aí a cota por cliente passa a ler o último salto do
# cabeçalho, que é o que esse proxy acrescenta. Vazio (o padrão) trata o
# cabeçalho como melhor esforço, porque quem chama direto pode escrever
# qualquer coisa nele.
#
# Vale para exatamente um proxy confiável. Com dois empilhados (CDN na frente
# da plataforma, por exemplo), o último salto é o IP do proxy intermediário e
# todos os visitantes passam a dividir uma cota só — nesse caso deixe vazio e
# confie no teto global por rota.
TRUSTED_PROXY=""
