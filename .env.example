# Configuração por implantação. Copie para .env.local e preencha.
# NUNCA versione segredos.

# URL pública do site (usada em SEO/Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Banco de dados desta implantação (PostgreSQL)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/site_modelo"

# Nome usado pelo seed ao criar a empresa (opcional; padrão vem do seed)
SEED_COMPANY_NAME=""

# Segredo que assina a sessão do painel. Obrigatório para o painel funcionar.
# Gere com: openssl rand -base64 48
# Trocar este valor invalida todas as sessões abertas.
AUTH_SECRET=""

# Primeiro usuário do painel, criado pelo seed. Sem os dois, nenhum usuário é
# criado (não existe usuário padrão). O seed nunca sobrescreve um já existente,
# então a senha trocada pela empresa fica preservada.
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# E-mail transacional (fase 6)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
