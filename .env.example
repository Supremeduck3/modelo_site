# Configuração por implantação. Copie para .env.local e preencha.
# NUNCA versione segredos.

# URL pública do site (usada em SEO/Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Banco de dados desta implantação (PostgreSQL).
#
# DATABASE_URL  — usada pelas consultas do site
# DIRECT_URL    — usada pelas migrations
#
# PostgreSQL próprio: as duas são iguais.
# Supabase: DATABASE_URL usa o pooler (porta 6543) com ?pgbouncer=true e
# DIRECT_URL usa a conexão direta (porta 5432). Ver docs/NOVA_IMPLANTACAO.md.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/site_modelo"
DIRECT_URL="postgresql://usuario:senha@localhost:5432/site_modelo"

# Nome usado pelo seed ao criar a empresa (opcional; padrão vem do seed)
SEED_COMPANY_NAME=""

# Segredo que assina a sessão do painel. Obrigatório para o painel funcionar.
# Gere com: openssl rand -base64 48
# Trocar este valor invalida todas as sessões abertas.
AUTH_SECRET=""

# Primeiro usuário do painel, criado pelo seed. Sem os dois, nenhum usuário é
# criado (não existe usuário padrão). O seed nunca sobrescreve um já existente,
# então a senha trocada pela empresa fica preservada.
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# E-mail transacional. Sem SMTP_HOST e MAIL_FROM o site funciona igual, só não
# envia (em desenvolvimento a mensagem vai para o log). Porta 465 usa TLS direto;
# as outras sobem para TLS via STARTTLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
